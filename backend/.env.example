# Gmail OTP configuration
# 1. Gumawa ng Gmail account (o gamitin ang existing)
# 2. I-enable ang 2-Step Verification: https://myaccount.google.com/security
# 3. Gumawa ng App Password: Google Account -> Security -> 2-Step Verification -> App passwords
#    (piliin ang "Mail" at "Windows Computer")
# 4. Ilagay dito ang email at ang 16-character App Password (walang spaces)

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
PORT=3001