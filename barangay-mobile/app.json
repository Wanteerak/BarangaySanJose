{
  "expo": {
    "name": "Barangay San Jose",
    "slug": "barangay-san-jose",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#ea580c"
    },
    "ios": {
      "bundleIdentifier": "com.barangaysanjose.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Kailangan ang camera para kumuha ng larawan ng inyong valid ID.",
        "NSPhotoLibraryUsageDescription": "Kailangan ang photo library para i-upload ang proof of identity."
      }
    },
    "android": {
      "package": "com.barangaysanjose.app",
      "adaptiveIcon": {
        "backgroundColor": "#ea580c"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": null
    },
    "extra": {
      "eas": {
        "projectId": "5ab0c5ac-56ff-4ea4-b084-d57086cb436d"
      }
    },
    "owner": "wanteerak"
  }
}
