{
  "name": "barangay-desktop",
  "version": "1.0.0",
  "description": "Barangay San Jose - Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "xcopy /E /I /Y ..\\barangay-web\\dist web-dist",
    "build": "npm run prebuild && electron-builder --win",
    "build:dir": "npm run prebuild && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.barangaysanjose.desktop",
    "productName": "Barangay San Jose",
    "directories": {
      "output": "release18"
    },
    "files": [
      "main.js",
      "build/icon.png",
      "web-dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Barangay San Jose"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
